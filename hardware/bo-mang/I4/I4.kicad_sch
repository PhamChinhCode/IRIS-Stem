(text "CƠ KHÍ VÀ GHI CHÚ" (exclude_from_sim no) (at 14.605 140.335 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "efe95a61-8629-568a-9f2b-9c1e60435fa8"))
(text "Bo 48 × 64 mm (khung L), lỗ gá Ø3,2 trong KH1." (exclude_from_sim no) (at 48.26 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ab99408b-a1ce-5258-b666-c28423305eeb"))
(text "Địa chỉ 0x20 (A0–A2 = GND).  Không dùng bản PCF8574A (dải địa chỉ khác)." (exclude_from_sim no) (at 48.26 154.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ed8c1fc0-d68d-5cbc-85e2-f72ea2ab43cb"))
(text "Quét: kéo từng hàng H xuống 0, đọc 4 cột C (cổng gần như hở cực máng, có kéo lên yếu)." (exclude_from_sim no) (at 48.26 160.02 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "dc29f0a6-f491-5572-afd3-8995f043efce"))
(text "Không có diode: nhấn 3 phím cùng lúc có thể ra phím ma." (exclude_from_sim no) (at 48.26 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ecabb5d7-994b-5afa-abb4-2ea1757bf58f"))
(text "3V3 tạo tại chỗ từ 5 V của cổng; tín hiệu về bo chủ luôn ở mức 3,3 V." (exclude_from_sim no) (at 48.26 170.18 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2c0d0f9e-ea58-5ed3-bda5-304172d25d74"))
(text "R, C nhỏ: 0603.  Thiết kế: THIET-KE-MACH.md mục 10." (exclude_from_sim no) (at 48.26 175.26 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4d444f65-0c70-5948-acf3-4c35d67f8e5e"))
