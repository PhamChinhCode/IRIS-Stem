(text "Bo 24 × 96 mm (khung Que), lỗ gá Ø3,2 trong KH1." (exclude_from_sim no) (at 48.26 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b768f3f2-3433-56bc-83dc-779ec556c506"))
(text "f = 1,44 / ((R_A + 2 R_B) × C) = 1,44 / (3 k × 1 nF) ≈ 480 kHz." (exclude_from_sim no) (at 48.26 154.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b1a2d574-d12a-5848-8163-0c4d79218435"))
(text "Đất ẩm → điện dung giữa hai bản cực tăng → biên độ tại bản cực A giảm → S1 giảm." (exclude_from_sim no) (at 48.26 160.02 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8dd85a60-02b6-505b-ba14-666b7a4370cc"))
(text "TP1, TP2 là hai vùng đồng phủ lớp cách điện ở phần que cắm xuống đất (vẽ khi layout)." (exclude_from_sim no) (at 48.26 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "51c2d4b3-25e5-5009-b54c-0066eb62d27f"))
(text "Giá trị R4, C5, R6 chốt khi thử trên bản mẫu." (exclude_from_sim no) (at 48.26 170.18 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "acf01d8c-b617-58f4-8a93-436623b99ec6"))
